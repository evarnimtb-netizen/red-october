Q.program_adopted = 0;
Q.georgia_free = 1;
Q.has_event = 0;
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// ---- relations with the other parties (0-100) ----
Q.rel_ally = 65;
Q.rel_lsr = 30;
Q.rel_bol = 25;
Q.rel_kad = 30;
Q.ally_lvl = 2;
Q.ally_lsr = 0;
Q.ally_bol = 0;

// ---- the party's currents ----
Q.factions = ['defencist', 'intl', 'rightdef', 'unions', 'bund'];
Q.defencist_strength = 50;
Q.defencist_dissent = 0;
Q.intl_strength = 20;
Q.intl_dissent = 20;
Q.rightdef_strength = 12;
Q.rightdef_dissent = 10;
Q.unions_strength = 10;
Q.unions_dissent = 5;
Q.bund_strength = 8;
Q.bund_dissent = 5;
Q.dissent = 0.1;
Q.dissent_percent = 10;

// ---- the player's campaign boosts among the voter groups (points of appeal) ----
Q.boost_workers = 0;
Q.boost_soldiers = 0;
Q.boost_peasants = 0;
Q.boost_middle = 0;
Q.boost_railway = 0;
Q.boost_nations = 0;

// ---- cooldown timers, in months ----
Q.timers = ['advisor_action', 'rally', 'fundraising', 'media', 'campaigning', 'ideology', 'party_disunity',
            'shuffle_leadership', 'inter_party_relationships', 'reichsbanner', 'response_to_antisemitism',
            'international_relations', 'peoples_party', 'neorevisionism',
            'labor_affairs', 'economic_policy', 'foreign_policy', 'agricultural_policy', 'military_policy',
            'constitutional_reform', 'nationalities', 'police',
            'economic_democracy', 'labor_rights', 'social_welfare', 'domestic_enemies', 'judiciary', 'fiscal_policy',
            'crisis', 'alt_coup', 'right_plot', 'council', 'cabinet', 'inside_sr', 'the_split', 'sovnarkom_seats', 'cheka_board', 'peasant_meeting', 'land_committees', 'peasant_congress', 'people_army', 'opp_kad', 'opp_gen', 'opp_bol', 'cow_kad', 'cow_gen', 'cow_bol', 'finance', 'money'];
for (var t of Q.timers) {
    Q[t + '_timer'] = 0;
}

// ---- advisors (1 = available) ----
Q.dan_advisor = 1;
Q.chkheidze_advisor = 1;
Q.tsereteli_advisor = 1;
Q.liber_advisor = 1;
Q.lidia_advisor = 1;
Q.abramovich_advisor = 1;
Q.potresov_advisor = 1;
Q.sukhanov_advisor = 1;
