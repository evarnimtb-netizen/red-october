@start
on-arrival: {!
Q.started = 1;
Q.game_over = 0;
Q.game_end = 0;
Q.ending = '';

// ---- time ----
// turns are half a month until the calendar reform (February 1918), then a month
Q.time = 1;
Q.year = 1917;
Q.month = 3;
Q.turn = 1;
Q.turn_length = 0.5;
// 0 = first half of the month, 1 = second half
Q.half_month = 0;
Q.month_complete = false;
// half-month index: 0 is the first half of March... of January 1917; events test this
Q.dix = 4;
Q.month_actions = 0;
Q.phase = 1;

// ---- difficulty ----
// -1 = easy, 0 = normal, 1 = hard
Q.difficulty = 0;
Q.discard_disabled = 0;
Q.hand_size = 3;
Q.saves_disabled = 0;

// ---- the player ----
Q.player_party = 'menshevik';
Q.player_slot = 'men';
Q.resources = 3;
Q.dues = 2;
// membership in thousands
Q.members = 60;
Q.mem_scale = 1;
Q.mem_div = 60;
Q.mem_cap = 400;
Q.poll_neutral = 9;

// ---- the state of the country (0-100) ----
Q.bread = 30;
Q.ruble = 60;
Q.war_weariness = 70;
Q.army_discipline = 50;
Q.land_pressure = 40;
Q.bolshevik = 20;
Q.right_threat = 30;
Q.soviet_democracy = 80;
Q.repression = 0;
// 3 = legal, 2 = tolerated, 1 = expelled from the Soviet executive, 0 = banned
Q.legality = 3;

// ---- the Civil War ----
Q.red_army = 15;
Q.white_front = 0;
Q.white_aid = 0;

// ---- government and flags ----
Q.at_war = 1;
Q.in_coalition = 0;
Q.gov_kadets = 0;
Q.bol_regime = 0;
Q.lsr_split = 0;
Q.land_decree = 0;
