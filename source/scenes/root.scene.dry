// counters and flags used by cards and events (all start at 0)
var flags = ['may_crisis_seen', 'larin_seen', 'crisis_count', 'vik_check_1', 'alt_coup_n', 'right_plot_n',
             'kornilov_won', 'militia', 'stockholm', 'famine_relief', 'program_dix', 'foreign_pressure',
             'georgia_support', 'workers_congress', 'insight', 'expelled', 'underground', 'readmission_hope',
