title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
Q.month_complete = false;
RO.clampStats(Q);
RO.updateFactions(Q);

// 1. update dates
// A turn is half a month until the calendar reform (Q.turn_length = 0.5), then a full month.
// Q.time, Q.month and Q.year only advance when a month is complete.
if (Q.month_actions >= 1) {
    Q.month_actions = 0;
    Q.turn += 1;
    // timers are measured in months, so each turn subtracts the turn length
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] = Math.max(0, Q[timer+'_timer'] - Q.turn_length);
        }
    }
    if (Q.turn_length < 1 && Q.half_month == 0) {
        Q.half_month = 1;
    } else {
        Q.half_month = 0;
        Q.month_complete = true;
    }
    // stats drift every turn, in proportion to its length
    RO.drift(Q, Q.turn_length);
    if (Q.month_complete) {
        Q.time += 1;
        Q.month += 1;
        if (Q.month >= 13) {
            Q.month = 1;
            Q.year += 1;
        }
    }
    Q.dix = RO.dix(Q.year, Q.month, Q.half_month);
    // the phase follows the calendar
    Q.phase = Q.dix < 20 ? 1 : (Q.dix < 25 ? 2 : (Q.dix < 34 ? 3 : (Q.dix < 92 ? 4 : 5)));
    if (Q.month_complete) {
        RO.updateFront(Q, Q.dix);
    }
    // membership follows the party's popularity and its legal status
    RO.clampStats(Q);
    RO.updatePolls(Q);
    Q.members += Q.turn_length * (0.7 * (Q.player_poll - 9) - (3 - Q.legality) * 1.5 - Q.repression / 25);
    if (Q.members < 3) { Q.members = 3; }
    Q.dues_income = Math.max(1, Math.round(Q.members / 60));
}
RO.clampStats(Q);
RO.updateFactions(Q);
RO.updatePolls(Q);
RO.display(Q);

// 2. immediate endings
if (!Q.game_end) {
    if (Q.bol_regime && Q.white_front >= 80) {
        Q.game_end = 1; Q.ending = 'white';
    } else if (Q.bol_regime && Q.legality <= 0 && Q.members <= 12) {
        Q.game_end = 1; Q.ending = 'exile';
    } else if (Q.year >= 1922) {
        Q.game_end = 1; Q.ending = 'final';
    }
}

// 3. look for events
Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: game_over if game_end = 1; events_choice if has_event = 1; main if has_event = 0 and hand_size = 3; main.main_easy if has_event = 0 and hand_size = 4

= [? if turn_length < 1 : [+ half_month : half_month +] ?][+ month : month +] [+ year +]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
