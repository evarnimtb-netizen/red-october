title: Next turn
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer <= 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Math.ceil(Q.advisor_action_timer) + ' months.';
}
!}
max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

- @party
- @coalition
- @soviet
- #advisor

@main_easy
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer <= 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Math.ceil(Q.advisor_action_timer) + ' months.';
}
!}
max-cards: 4

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

- @party
- @coalition
- @soviet
- #advisor

@party
title: Party Affairs
card-image: img/cards/deck_party.svg
is-deck: true

- #party_affairs

@coalition
title: Coalition Affairs
card-image: img/cards/deck_coalition.svg
subtitle: The ministries our party holds or supervises.
view-if: in_coalition = 1 and bol_regime = 0 and player_party != 'lsr'
is-deck: true

- #coalition_affairs

@soviet
title: Soviet Affairs
card-image: img/cards/deck_soviet.svg
subtitle: Working in the soviets, the unions and the cooperatives.
view-if: bol_regime = 1
is-deck: true

- #soviet_affairs
